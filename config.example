# Copy to /etc/delugearr/config (chmod 600) or export as env vars.
# This file is read by the systemd unit via EnvironmentFile=.
DELUGE_URL=http://127.0.0.1:8112
DELUGE_PASSWORD=CHANGE_ME
PORT=11012
# Optional: mount the app under a sub-path (e.g. /delugearr) behind a reverse
# proxy that strips the prefix. Default: served at the root (/).
# BASE_PATH=/delugearr
CONFIG_PATH=/etc/delugearr
# 1 = detect + log only (default, safe). 0 = actually remove torrents.
DRY_RUN=1
SCAN_INTERVAL_MINUTES=30
# Web UI login (independent of the nginx basic auth; both apply).
AUTH_USER=admin
AUTH_PASSWORD=CHANGE_ME
# Optional: fixed session secret; generated and persisted automatically if unset.
# STORAGE_SECRET=changeme
# Bind address for the server. Defaults to localhost; set 0.0.0.0 to expose it
# on the network (put a reverse proxy in front if you do).
# HOST=0.0.0.0
# JSON list of paths whose data must never be deleted (optional safety net;
# unregistered torrents otherwise delete torrent + data).
# KEEP_DATA_PATHS=["/data/torrents/keep"]
# Max torrents listed in a Discord or ntfy summary message (0 = summary only).
# The default 25 keeps a big cleanup from flooding the channel. Connections
# (webhook/topic URL, Discord username/avatar, ntfy access token, event
# triggers) are configured in the UI.
# NOTIFY_MAX_ITEMS=25
# Public base URL where this app's UI is reachable. Used to build the "Open
# full run" link in Discord summary messages. Any value with a trailing slash
# is normalised. If unset, the link is omitted. Also settable in the UI.
# NOTIFY_URL_BASE=https://delugearr.example.com
